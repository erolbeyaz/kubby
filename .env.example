# Kubby — ornek ortam degiskenleri
#
# BU DOSYA GERCEK DEGER ICERMEZ VE ICERMEYECEKTIR.
# Kullanim:  cp .env.example .env   ve .env dosyasini doldur (.env gitignore'ludur).
# Kubernetes'te bu degerler Secret'tan gelir, dosyadan degil.
# Tam aciklamalar: docs/ARCHITECTURE.md -> Ortam Degiskenleri

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
KUBBY_HTTP_ADDR=:8080
# Kubby'nin disaridan erisilen adresi. Cookie Secure, CSP ve CORS bunu kullanir.
KUBBY_PUBLIC_URL=http://localhost:8080
KUBBY_LOG_LEVEL=info
# true yapilirsa tum yazma islemleri kapanir (incident sirasinda guvenlik kilidi)
KUBBY_READ_ONLY=false
# KUBBY_TRUSTED_PROXIES=10.0.0.0/8

# Extra origins accepted for mutating requests, when the app is reachable under more
# than one hostname (load-balancer alias, internal name). KUBBY_PUBLIC_URL is always
# trusted; list absolute origins, comma separated.
# KUBBY_ALLOWED_ORIGINS=https://kubby-alias.example.com

# --- TLS (ADR-020) ---
# Kubby kendi TLS'ini sonlandiracaksa ikisini de doldur.
# Onunde ingress/LB varsa bos birak; duz HTTP dinler.
# KUBBY_TLS_CERT_FILE=/etc/kubby/tls/tls.crt
# KUBBY_TLS_KEY_FILE=/etc/kubby/tls/tls.key
# Extra root CA — APPENDED to the system trust store, never replaces it.
# Needed when cluster APIs or log sinks use a private/self-signed CA.
# KUBBY_EXTRA_CA_BUNDLE=/etc/kubby/certs/internal-ca.crt

# --- Proxy (needed when cluster endpoints are only reachable through a proxy) ---
# HTTP_PROXY=http://proxy.example.local:3128
# HTTPS_PROXY=http://proxy.example.local:3128
# NO_PROXY=.example.local,10.0.0.0/8,localhost

# ---------------------------------------------------------------------------
# Database (PostgreSQL 18.6)
# ---------------------------------------------------------------------------
KUBBY_DB_HOST=postgres
KUBBY_DB_PORT=5432
KUBBY_DB_NAME=kubby
KUBBY_DB_USER=kubby
# CHANGE_ME — gercek parolayi buraya degil .env dosyasina yaz
KUBBY_DB_PASSWORD=CHANGE_ME
KUBBY_DB_SSLMODE=disable
KUBBY_DB_MAX_CONNS=20

# ---------------------------------------------------------------------------
# Encryption  (bkz. ADR-009)
# ---------------------------------------------------------------------------
# 32 baytlik base64 anahtar. Uretmek icin:  openssl rand -base64 32
# Bu anahtar kaybolursa kayitli kubeconfigler geri getirilemez.
KUBBY_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES
KUBBY_ENCRYPTION_KEY_VERSION=1
# none | aws-kms | gcp-kms | vault
KUBBY_KMS_PROVIDER=none

# ---------------------------------------------------------------------------
# Auth & session
# ---------------------------------------------------------------------------
KUBBY_SESSION_TTL=15m
KUBBY_REFRESH_TTL=12h
KUBBY_ARGON2_MEMORY_MB=64
# Wrong-password attempts before a lockout starts.
KUBBY_LOGIN_MAX_ATTEMPTS=5
# Lockouts escalate; the last entry repeats if there are more lockouts than entries.
KUBBY_LOCKOUT_DURATIONS=5m,10m
# Lockouts before a non-admin account is blocked outright.
# Administrators are never blocked, so an installation stays administrable.
KUBBY_MAX_LOCKOUTS=3
KUBBY_REQUIRE_2FA_FOR_ADMIN=true

# ---------------------------------------------------------------------------
# Kubernetes client
# ---------------------------------------------------------------------------
KUBBY_K8S_QPS=50
KUBBY_K8S_BURST=100
KUBBY_K8S_TIMEOUT=30s
KUBBY_INFORMER_IDLE_TTL=30m
KUBBY_INFORMER_MAX_MEMORY_MB=128
# Kendi cluster'ina ServiceAccount ile baglanma (ADR-022).
# Yalnizca Kubby bir K8s pod'unda calisirken anlamli. Varsayilan KAPALI.
KUBBY_ALLOW_IN_CLUSTER=false


# ---------------------------------------------------------------------------
# Logging & audit  (bkz. ADR-010)
# ---------------------------------------------------------------------------
# Virgulle birden fazla hedef verilebilir: stdout,elasticsearch,syslog
# Desteklenen: stdout | elasticsearch | loki | syslog
KUBBY_LOG_SINKS=stdout
KUBBY_LOG_BUFFER_SIZE=10000
KUBBY_AUDIT_RETENTION_DAYS=365

# --- Elasticsearch (KUBBY_LOG_SINK=elasticsearch ise) ---
# KUBBY_ES_URL=https://elasticsearch.example.local:9200
# KUBBY_ES_INDEX=kubby-logs
# none | basic | apikey | bearer
# KUBBY_ES_AUTH_MODE=none
# KUBBY_ES_AUTH_SECRET=CHANGE_ME
# KUBBY_ES_TLS_CA_FILE=/etc/kubby/certs/ca.crt

# --- Loki (KUBBY_LOG_SINK=loki ise) ---
# KUBBY_LOKI_URL=http://loki.example.local:3100
# KUBBY_LOKI_AUTH_MODE=none
# KUBBY_LOKI_AUTH_SECRET=CHANGE_ME

# --- Syslog sink, e.g. to forward the audit stream to a SIEM (ADR-021) ---
# RFC 5424, TCP + TLS
# KUBBY_SYSLOG_ADDR=siem.example.local:6514
# audit | audit,application
# KUBBY_SYSLOG_STREAMS=audit

# --- /metrics erisimi ---
# KUBBY_METRICS_TOKEN=CHANGE_ME

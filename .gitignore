# --- Secrets: asla commit edilmez ---
.env
.env.*
# Every *.example is a template with no real values in it. The wildcard has to cover
# them all: `!.env.example` alone let `.env.published.example` fall back through `.env.*`
# and quietly stay untracked.
!.env*.example
*.pem
*.key
*.crt
*.p12
kubeconfig
kubeconfig-*
*.kubeconfig
secrets/
.secrets/

# --- Go ---
/server/bin/
/server/tmp/
*.exe
*.test
*.out
coverage.out
coverage.html
__debug_bin*
vendor/

# --- Node / frontend ---
node_modules/
/web/dist/
/web/.vite/
/web/coverage/
# Frontend build output is generated by `make build`; only the placeholder is tracked
# so `go:embed all:dist` compiles on a fresh clone.
/server/internal/webassets/dist/**
!/server/internal/webassets/dist/
!/server/internal/webassets/dist/.gitkeep
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-error.log*

# --- Test / araçlar ---
/test-results/
/playwright-report/
/blob-report/
.playwright/
*.trivy.json
gitleaks-report.json

# --- Loglar ---
*.log
# Anchored: an unanchored `logs/` matches every directory of that name anywhere, and this
# repository has one full of source — web/src/features/logs. A fresh clone was missing the
# log viewer entirely and would not build.
/logs/

# --- Yerel geliştirme ---
/data/
/tmp/
docker-compose.override.yml

# --- Claude Code ---
.claude/settings.local.json

# --- Editör / işletim sistemi ---
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
